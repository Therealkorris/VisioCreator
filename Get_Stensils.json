      {
        "parameters": {
          "functionCode": "const categories = $json.body;  // Access the body where stencil files and shapes are listed\n\nconst shapeEntries = [];\n\n// Loop through each stencil file and shape in the incoming JSON data\nfor (const stencilFile in categories) {\n    const shapes = categories[stencilFile];\n    shapes.forEach(shape => {\n        // Add each shape with its stencil file as a structured entry\n        shapeEntries.push({\n            stencil_file: stencilFile,\n            shape_name: shape\n        });\n    });\n}\n\n// Output each shape entry as a separate JSON object\nreturn shapeEntries.map(entry => ({ json: entry }));\n"
        },
        "id": "a434f84e-749e-4757-93b1-a84235e849d7",
