      "parameters": {
        "functionCode": "const categories = $json.body;  // Access the body with stencil files and shapes\n\nconst shapeEntries = [];\n\nfor (const stencilFile in categories) {\n    const shapes = categories[stencilFile];\n    shapes.forEach(shape => {\n        shapeEntries.push({\n            json: {\n                library: stencilFile, // Library name\n                shape: shape         // Shape name\n            }\n        });\n    });\n}\n\nreturn shapeEntries;\n"
      },
