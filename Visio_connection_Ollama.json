    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const updatedData = {};\n  \n  // Iterate through all keys in the 'different' object\n  if (item.json.different) {\n    Object.keys(item.json.different).forEach(key => {\n      const inputB = item.json.different[key]?.inputB;\n      if (inputB !== undefined && inputB !== null) {\n        updatedData[key] = inputB; // Use the value from Input B for updates\n      }\n    });\n  }\n\n  if (Object.keys(updatedData).length === 0) {\n    return null; // Skip if no updates\n  }\n\n  return {\n    json: {\n      ...item.json.keys, // Include identifying keys (like shape_id)\n      ...updatedData, // Include the updated fields\n    },\n  };\n}).filter(item => item !== null); // Filter out null items\n"
      },
