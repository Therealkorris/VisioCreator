    {
      "parameters": {
        "jsCode": "// Log the entire input to debug the structure\nconsole.log($input.first().json);\n\n// Attempt to access shapes data from different sources\nconst inputData = $input.first().json.body || $input.first().json; // Supports both webhook and chat\n\n// Ensure the structure exists\nif (!inputData || !inputData.shapes) {\n  throw new Error('Shapes data is missing or not properly formatted');\n}\n\n// Debugging shapes structure\nconsole.log(inputData.shapes);\n\n// Access shapes array directly\nconst shapes = inputData.shapes.shapes || inputData.shapes; // Adjust based on structure\nif (!shapes) {\n  throw new Error('Shapes array is missing or not properly formatted');\n}\n\n// Map keys to exact Supabase table column names\nconst transformKeysForSupabase = (obj) => {\n  const keyMap = {\n    ShapeId: \"shape_id\",\n    ShapeType: \"shape_type\",\n    ShapeColor: \"shape_color\",\n    Text: \"text\",\n    PosX: \"pos_x\",\n    PosY: \"pos_y\",\n    Width: \"width\",\n    Height: \"height\",\n    Angle: \"angle\",\n    ZOrder: \"z_order\",\n    CustomProperties: \"custom_properties\",\n    IsConnector: \"is_connector\",\n    ConnectorType: \"connector_type\",\n    SourceShapeId: \"source_shape_id\",\n    TargetShapeId: \"target_shape_id\",\n    BeginX: \"begin_x\",\n    BeginY: \"begin_y\",\n    EndX: \"end_x\",\n    EndY: \"end_y\",\n    RoutingPoints: \"routing_points\",\n    ConnectorPattern: \"connector_pattern\",\n    ConnectorWeight: \"connector_weight\",\n    ConnectorRounding: \"connector_rounding\",\n    ControlPoints: \"control_points\",\n  };\n\n  const newObj = {};\n  for (const key in obj) {\n    if (obj.hasOwnProperty(key)) {\n      const newKey = keyMap[key] || key.toLowerCase();\n      newObj[newKey] = obj[key];\n    }\n  }\n  return newObj;\n};\n\n// Split and transform shapes into individual items\nreturn shapes.map(shape => ({ json: transformKeysForSupabase(shape) }));\n"
      },
