    {
      "parameters": {
        "jsCode": "// Standardize binary data field name to 'data'\nconst item = $input.first();\n\nif (item.binary) {\n    // If from chat (data0)\n    if (item.binary.data0) {\n        return {\n            binary: {\n                data: item.binary.data0\n            }\n        };\n    }\n    // If from webhook (image)\n    else if (item.binary.image) {\n        return {\n            binary: {\n                data: item.binary.image\n            }\n        };\n    }\n}\n\n// If no binary data found, return empty\nreturn {\n    binary: {\n        data: null\n    }\n};"
      },
